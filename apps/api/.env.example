DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hopehub_clinic?schema=public"
JWT_SECRET="change-this-before-production"
NODE_ENV="development"
PORT=4000
API_PUBLIC_URL="http://localhost:4000"
API_URL="http://localhost:4000"
WEB_ORIGIN="http://localhost:4203"
CORS_ORIGINS="https://hopehub.in,https://www.hopehub.in,http://localhost:4200,http://127.0.0.1:4200,http://localhost:4201,http://127.0.0.1:4201,http://localhost:4202,http://127.0.0.1:4202,http://localhost:4203,http://127.0.0.1:4203,http://localhost:4204,http://127.0.0.1:4204,http://localhost:5800,http://127.0.0.1:5800"
ADMIN_ORIGIN="http://localhost:4201"
DOCTOR_ORIGIN="http://localhost:4202"
OPERATIONS_ORIGIN="http://localhost:5800"
# Redis (optional — OTP store falls back to in-memory when unset)
REDIS_URL="redis://localhost:6379"
# Patient app download links (optional — QR /go/app uses these when set)
PATIENT_APP_ANDROID_URL=""
PATIENT_APP_IOS_URL=""
PATIENT_APP_NAME="HopeHub Patient"
PATIENT_APP_PACKAGE_ID="com.hopehubclinic.patient"
DEV_OTP="123456"
DISABLE_DEV_DEMO="false"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
GOOGLE_CLIENT_ID=""
# Email delivery.
# For AWS SES SMTP, use the SES SMTP endpoint for your verified region.
# Example Mumbai host: email-smtp.ap-south-1.amazonaws.com
# Example N. Virginia host: email-smtp.us-east-1.amazonaws.com
# AWS_SES_SMTP_USERNAME and AWS_SES_SMTP_PASSWORD are SES SMTP credentials, not normal AWS access keys.
SMTP_FROM="contact@hopehub.in"
AWS_SES_SMTP_HOST="email-smtp.us-east-1.amazonaws.com"
AWS_SES_SMTP_PORT="587"
AWS_SES_SMTP_USERNAME=""
AWS_SES_SMTP_PASSWORD=""
CONTACT_MAIL_BUCKET="hopehub-contact-inbox"
CONTACT_MAIL_PREFIX="contact/"
CONTACT_MAIL_REGION="us-east-1"
CONTACT_REPLY_FROM="contact@hopehub.in"
ASSET_BUCKET="hopehub-assets"
ASSET_BUCKET_REGION="us-east-1"
# Optional private asset base URL. Usually leave blank unless private assets are served by a CDN/signed URL layer.
ASSET_BASE_URL=""
# Temporary signed URL lifetime for private S3 assets.
ASSET_SIGNED_URL_TTL_SECONDS="900"
# Public website asset bucket. Use only for non-sensitive media that can be read by anyone.
PUBLIC_ASSET_BUCKET="hopehub-public-assets-924479393196"
PUBLIC_ASSET_BUCKET_REGION="us-east-1"
# Optional CDN/custom domain for public assets. Example: https://cdn.hopehub.in
PUBLIC_ASSET_BASE_URL=""
DOSE_OVERDUE_SWEEP_ENABLED="true"
DOSE_OVERDUE_SWEEP_INTERVAL_MS="300000"
DOSE_REMINDER_SWEEP_ENABLED="true"
DOSE_REMINDER_WINDOW_MINUTES="30"
NOTIFICATION_CHANNELS="IN_APP,SMS,WHATSAPP,EMAIL,PUSH"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""
# OOREP GPL repertory import (optional — see apps/api/data/oorep/README.md)
OOREP_SQL_PATH="data/oorep/oorep.sql"
# Live OOREP proxy (optional — used when local repertory data is unavailable)
OOREP_BASE_URL="https://www.oorep.com"
OOREP_TIMEOUT_MS="15000"
# WebRTC TURN server (optional — falls back to public STUN when unset)
TURN_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""
# Local vision AI for clinical image analysis (optional — requires Ollama running locally)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_VISION_MODEL="qwen2.5-vl:7b"
OLLAMA_VISION_TIMEOUT_MS="120000"

# Telegram workflow bots managed by the API.
# User/web workflow bot: @Hopehubbot
TELEGRAM_USER_BOT_TOKEN=""
# Care team/provider bot: @Hopehubprovidersbot
TELEGRAM_DOCTOR_BOT_TOKEN=""
# Internal ops bot: @Hopehuboperationbot
TELEGRAM_ADMIN_BOT_TOKEN=""
# Sent by Telegram as X-Telegram-Bot-Api-Secret-Token for webhook verification.
TELEGRAM_WEBHOOK_SECRET=""
# Required only for calling /telegram/bots/*/setup endpoints.
TELEGRAM_SETUP_SECRET=""
