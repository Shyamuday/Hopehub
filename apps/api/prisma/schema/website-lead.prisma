enum WebsiteLeadSource {
  CHAT_BOT
  HOME_BOOKING
  PROMO_POPUP
}

enum WebsiteLeadFollowUp {
  NEW
  NEEDS_CALLBACK
  CALLED
  NO_ANSWER
  WHATSAPP_SENT
  REGISTERED
  BOOKED
  NOT_INTERESTED
  CLOSED
}

enum WebsiteLeadAssignmentType {
  VOLUNTEER
  PSYCHOLOGIST
  ADMIN
}

enum WebsiteLeadAssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
  CONTACTED
  COMPLETED
  CANCELLED
}

model WebsiteLead {
  id             String              @id @default(cuid())
  source         WebsiteLeadSource
  followUpStatus WebsiteLeadFollowUp @default(NEW)
  visitorName    String?
  visitorPhone   String?
  visitorEmail   String?
  concern        String?
  /// Health issue or problem shared during reception follow-up call
  visitorIssue   String?             @db.Text
  /// Preset or free-text reason when marked not interested
  notInterestedReason String?
  entryPage      String?
  visitorKey     String?
  userId         String?
  user           User?               @relation("UserWebsiteLeads", fields: [userId], references: [id], onDelete: SetNull)
  chatSessionId  String?             @unique
  chatSession    ChatSession?        @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  operatorNote          String?
  preferredCallbackTime String?
  calledAt              DateTime?
  calledById            String?
  calledBy              User?               @relation("LeadCalledBy", fields: [calledById], references: [id], onDelete: SetNull)
  assignments           WebsiteLeadAssignment[]
  registeredAt          DateTime?
  bookedAt              DateTime?
  consultationId        String?             @unique
  consultation          Consultation?       @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([followUpStatus])
  @@index([source])
  @@index([visitorPhone])
  @@index([userId])
  @@index([consultationId])
  @@index([createdAt])
}

model WebsiteLeadAssignment {
  id             String                      @id @default(cuid())
  leadId         String
  lead           WebsiteLead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  providerId     String?
  provider       User?                       @relation("LeadAssignmentProvider", fields: [providerId], references: [id], onDelete: SetNull)
  assignedById   String?
  assignedBy     User?                       @relation("LeadAssignmentAdmin", fields: [assignedById], references: [id], onDelete: SetNull)
  assignmentType WebsiteLeadAssignmentType
  status         WebsiteLeadAssignmentStatus @default(PENDING)
  note           String?                     @db.Text
  assignedAt     DateTime                    @default(now())
  acceptedAt     DateTime?
  declinedAt     DateTime?
  contactedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([leadId])
  @@index([providerId])
  @@index([assignedById])
  @@index([status])
  @@index([assignmentType])
  @@index([assignedAt])
}
