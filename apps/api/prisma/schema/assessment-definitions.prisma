model AssessmentDefinition {
  id String @id

  type        String
  category    String
  title       String
  description String @db.Text
  version     String @default("v1")

  config Json

  accessMode           String    @default("FREE")
  priceInPaise         Int?
  couponCode           String?
  couponLabel          String?
  couponDiscountType   String    @default("FREE")
  couponDiscountValue  Int?
  couponStartsAt       DateTime?
  couponEndsAt         DateTime?
  couponMaxRedemptions Int?
  accessNote           String?   @db.Text

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accessGrants      AssessmentAccessGrant[]
  couponRedemptions AssessmentCouponRedemption[]
  payments          AssessmentPayment[]
  coupons           AssessmentCoupon[]

  @@index([category, isActive])
  @@index([isActive, sortOrder])
  @@index([accessMode])
}

model AssessmentCoupon {
  id             String    @id @default(cuid())
  assessmentId   String
  code           String
  label          String?
  discountType   String    @default("FREE")
  discountValue  Int?
  startsAt       DateTime?
  endsAt         DateTime?
  maxRedemptions Int?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assessment AssessmentDefinition @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, code])
  @@index([code, isActive])
  @@index([assessmentId, isActive])
}

model AssessmentPayment {
  id                String        @id @default(cuid())
  userId            String
  assessmentId      String
  provider          String        @default("razorpay")
  providerOrderId   String        @unique
  providerPaymentId String?
  amountInPaise     Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  notes             Json?
  verifiedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user       User                 @relation("AssessmentPayments", fields: [userId], references: [id], onDelete: Cascade)
  assessment AssessmentDefinition @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([assessmentId, status])
  @@index([providerPaymentId])
}

model AssessmentAccessGrant {
  id           String   @id @default(cuid())
  userId       String
  assessmentId String
  source       String
  couponCode   String?
  paymentId    String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())

  user       User                 @relation("AssessmentAccessGrants", fields: [userId], references: [id], onDelete: Cascade)
  assessment AssessmentDefinition @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([userId, assessmentId, source, couponCode])
  @@index([assessmentId, createdAt])
  @@index([userId, createdAt])
}

model AssessmentCouponRedemption {
  id           String   @id @default(cuid())
  userId       String
  assessmentId String
  couponCode   String
  createdAt    DateTime @default(now())

  user       User                 @relation("AssessmentCouponRedemptions", fields: [userId], references: [id], onDelete: Cascade)
  assessment AssessmentDefinition @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([userId, assessmentId, couponCode])
  @@index([assessmentId, couponCode])
}
