model NotificationTemplate {
  id         String                  @id @default(cuid())
  code       String                  @unique
  name       String
  title      String
  body       String
  channel    String                  @default("IN_APP")
  isActive   Boolean                 @default(true)
  broadcasts NotificationBroadcast[]
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
}

model NotificationBroadcast {
  id             String                @id @default(cuid())
  templateId     String?
  template       NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title          String
  body           String
  channel        String
  audience       String
  audienceRole   Role?
  recipientCount Int                   @default(0)
  createdById    String?
  createdBy      User?                 @relation("NotificationBroadcasts", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now())

  @@index([createdAt])
}

model InAppNotification {
  id                    String    @id @default(cuid())
  recipientUserId       String?
  recipientStoreStaffId String?
  eventType             String
  title                 String
  body                  String
  metadata              Json?
  readAt                DateTime?
  createdAt             DateTime  @default(now())

  recipientUser       User?       @relation("UserInAppNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientStoreStaff StoreStaff? @relation("StoreStaffInAppNotifications", fields: [recipientStoreStaffId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt, createdAt])
  @@index([recipientStoreStaffId, readAt, createdAt])
}

enum ConsultationReminderType {
  SESSION_24H
  SESSION_1H
  MISSED_SESSION_FOLLOW_UP
  ADMIN_UNASSIGNED_ALERT
}

enum ConsultationReminderStatus {
  PENDING
  SENT
  CANCELLED
  SKIPPED
}

model ConsultationReminder {
  id              String                     @id @default(cuid())
  consultationId  String
  recipientUserId String?
  type            ConsultationReminderType
  scheduledFor    DateTime
  status          ConsultationReminderStatus @default(PENDING)
  sentAt          DateTime?
  cancelledAt     DateTime?
  metadata        Json?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  consultation  Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  recipientUser User?        @relation("UserConsultationReminders", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([consultationId, recipientUserId, type])
  @@index([status, scheduledFor])
  @@index([recipientUserId, status])
  @@index([consultationId])
}

model PushDevice {
  id           String      @id @default(cuid())
  userId       String?
  storeStaffId String?
  token        String      @unique @db.Text
  platform     String
  provider     String      @default("FCM")
  isActive     Boolean     @default(true)
  failureCount Int         @default(0)
  lastSeenAt   DateTime    @default(now())
  disabledAt   DateTime?
  user         User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeStaff   StoreStaff? @relation(fields: [storeStaffId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId, isActive])
  @@index([storeStaffId, isActive])
  @@index([lastSeenAt])
}
