enum VacancyStatus {
  DRAFT
  OPEN
  CLOSED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum LocationType {
  REMOTE
  ON_SITE
  HYBRID
}

enum CounsellorApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  REJECTED
  ONBOARDED
}

enum CounsellorApplicationTrack {
  PROFESSIONAL_PSYCHOLOGIST
  PSYCHOLOGY_STUDENT_VOLUNTEER
  PEER_SUPPORT_VOLUNTEER
}

// This is deliberately separate from User/Doctor. Creating an onboarding record
// must never give a student or peer volunteer access to clinical data or a doctor
// workspace. A platform account can only be connected in a later, reviewed step.
enum CareContributorStatus {
  PENDING_ORIENTATION
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum CareContributorServiceScope {
  CLINICAL_PSYCHOLOGY
  SUPERVISED_STUDENT_SUPPORT
  NON_CLINICAL_PEER_SUPPORT
}

enum CredentialVerificationStatus {
  NOT_REQUIRED
  PENDING
  VERIFIED
  EXPIRED
  REJECTED
}

model JobVacancy {
  id               String        @id @default(cuid())
  title            String
  department       String
  jobType          JobType       @default(FULL_TIME)
  locationType     LocationType  @default(ON_SITE)
  location         String?
  description      String        @db.Text
  requirements     String[]      @default([])
  responsibilities String[]      @default([])
  status           VacancyStatus @default(DRAFT)
  isUrgent         Boolean       @default(false)
  deadline         DateTime?
  salaryRange      String?
  createdById      String?
  createdBy        User?         @relation("VacancyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@index([department])
  @@index([createdAt])
}

model CounsellorApplication {
  id                  String                       @id @default(cuid())
  status              CounsellorApplicationStatus  @default(NEW)
  applicationTrack    CounsellorApplicationTrack   @default(PROFESSIONAL_PSYCHOLOGIST)
  careTeamType        CareTeamMemberType           @default(MENTAL_WELLNESS_PROFESSIONAL)
  fullName            String
  email               String
  phone               String
  gender              PatientGender?
  city                String
  qualification       String?
  qualifiedFrom       String?
  specialization      String?
  experienceYears     String?
  registrationDetails String?
  languages           String
  availability        String
  preferredChannel    String
  resumeLink          String?
  portfolioLink       String?
  supervisionDetails  String?                      @db.Text
  livedExperienceSummary String?                   @db.Text
  agreesToNonClinicalRole Boolean                  @default(false)
  whyJoin             String                       @db.Text
  listenerScreeningAnswers Json?
  listenerScreeningScore Int?
  listenerScreeningMaxScore Int?
  listenerScreeningPassed Boolean                  @default(false)
  listenerScreeningCompletedAt DateTime?
  listenerGuidelinesAccepted Boolean              @default(false)
  listenerGuidelinesVersion String?
  listenerGuidelinesAcceptedAt DateTime?
  autoApprovedAt      DateTime?
  autoApprovedDoctorUserId String?
  source              String                       @default("healing-web")
  entryPage           String?
  adminNote           String?                      @db.Text
  reviewedById        String?
  reviewedBy          User?                        @relation("CounsellorApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt          DateTime?
  onboardedContributor CareContributor?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@index([status])
  @@index([applicationTrack])
  @@index([email])
  @@index([phone])
  @@index([specialization])
  @@index([createdAt])
}

model CareContributor {
  id                           String                         @id @default(cuid())
  applicationId                String                         @unique
  application                  CounsellorApplication          @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  applicationTrack             CounsellorApplicationTrack
  careTeamType                 CareTeamMemberType          @default(MENTAL_WELLNESS_PROFESSIONAL)
  serviceScope                 CareContributorServiceScope
  status                       CareContributorStatus          @default(PENDING_ORIENTATION)
  credentialVerificationStatus CredentialVerificationStatus   @default(PENDING)
  fullName                     String
  email                        String
  phone                        String
  gender                       PatientGender?
  city                         String
  qualification                String?
  qualifiedFrom                String?
  specialization               String?
  registrationDetails          String?
  languages                    String
  availability                 String
  supervisionDetails           String?                        @db.Text
  nonClinicalAgreementAccepted Boolean                        @default(false)
  credentialVerifiedAt         DateTime?
  supervisionVerifiedAt        DateTime?
  orientationCompletedAt       DateTime?
  activatedAt                  DateTime?
  onboardingNote               String?                        @db.Text
  // No account is created by this model. It exists to make the later account
  // and assignment step explicit and reviewable.
  platformAccountLinkedAt      DateTime?
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt

  @@index([status])
  @@index([applicationTrack])
  @@index([serviceScope])
  @@index([email])
}
