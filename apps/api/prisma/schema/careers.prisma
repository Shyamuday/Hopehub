enum VacancyStatus {
  DRAFT
  OPEN
  CLOSED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum LocationType {
  REMOTE
  ON_SITE
  HYBRID
}

enum CounsellorApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  REJECTED
  ONBOARDED
}

enum CounsellorApplicationTrack {
  PROFESSIONAL_PSYCHOLOGIST
  PSYCHOLOGY_STUDENT_VOLUNTEER
  PEER_SUPPORT_VOLUNTEER
}

// This is deliberately separate from User/Doctor. Creating an onboarding record
// must never give a student or peer volunteer access to clinical data or a doctor
// workspace. A platform account can only be connected in a later, reviewed step.
enum CareContributorStatus {
  PENDING_ORIENTATION
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum CareContributorServiceScope {
  CLINICAL_PSYCHOLOGY
  SUPERVISED_STUDENT_SUPPORT
  NON_CLINICAL_PEER_SUPPORT
}

enum CredentialVerificationStatus {
  NOT_REQUIRED
  PENDING
  VERIFIED
  EXPIRED
  REJECTED
}

model JobVacancy {
  id               String        @id @default(cuid())
  title            String
  department       String
  jobType          JobType       @default(FULL_TIME)
  locationType     LocationType  @default(ON_SITE)
  location         String?
  description      String        @db.Text
  requirements     String[]      @default([])
  responsibilities String[]      @default([])
  status           VacancyStatus @default(DRAFT)
  isUrgent         Boolean       @default(false)
  deadline         DateTime?
  salaryRange      String?
  createdById      String?
  createdBy        User?         @relation("VacancyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@index([department])
  @@index([createdAt])
}

model CounsellorApplication {
  id                  String                       @id @default(cuid())
  status              CounsellorApplicationStatus  @default(NEW)
  applicationTrack    CounsellorApplicationTrack   @default(PROFESSIONAL_PSYCHOLOGIST)
  careTeamType        CareTeamMemberType           @default(MENTAL_WELLNESS_PROFESSIONAL)
  fullName            String
  email               String
  phone               String
  gender              PatientGender?
  city                String
  qualification       String?
  qualifiedFrom       String?
  specialization      String?
  experienceYears     String?
  registrationDetails String?
  languages           String
  availability        String
  preferredChannel    String
  resumeLink          String?
  portfolioLink       String?
  supervisionDetails  String?                      @db.Text
  livedExperienceSummary String?                   @db.Text
  agreesToNonClinicalRole Boolean                  @default(false)
  whyJoin             String                       @db.Text
  listenerScreeningQuestionSetId String?
  listenerScreeningQuestionSetVersion String?
  listenerScreeningAnswers Json?
  listenerScreeningScore Int?
  listenerScreeningMaxScore Int?
  listenerScreeningPassed Boolean                  @default(false)
  listenerScreeningCompletedAt DateTime?
  listenerGuidelinesAccepted Boolean              @default(false)
  listenerGuidelinesVersion String?
  listenerGuidelinesReadStartedAt DateTime?
  listenerGuidelinesReadSeconds Int?
  listenerGuidelinesAcceptedAt DateTime?
  listenerTrainingCompleted Boolean                 @default(false)
  listenerTrainingVersion String?
  listenerTrainingCompletedAt DateTime?
  autoApprovedAt      DateTime?
  autoApprovedDoctorUserId String?
  source              String                       @default("healing-web")
  entryPage           String?
  adminNote           String?                      @db.Text
  reviewedById        String?
  reviewedBy          User?                        @relation("CounsellorApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt          DateTime?
  onboardedContributor CareContributor?
  listenerScreeningAttempts ListenerScreeningAttempt[]
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@index([status])
  @@index([applicationTrack])
  @@index([listenerScreeningQuestionSetId])
  @@index([email])
  @@index([phone])
  @@index([specialization])
  @@index([listenerScreeningPassed, listenerScreeningCompletedAt])
  @@index([createdAt])
}

model ListenerScreeningQuestionSet {
  id           String   @id @default(cuid())
  title        String   @default("Listener screening test")
  version      String   @unique
  description  String?  @db.Text
  passScore    Int      @default(16)
  questions    Json
  isActive     Boolean  @default(false)
  publishedAt  DateTime?
  createdById  String?
  updatedById  String?
  attempts     ListenerScreeningAttempt[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, publishedAt])
  @@index([createdById])
  @@index([updatedById])
}

model ListenerGuidelineReadSession {
  id                String   @id @default(cuid())
  tokenHash         String   @unique
  applicationTrack  CounsellorApplicationTrack
  email             String
  phone             String
  guidelinesVersion String
  minReadSeconds    Int      @default(120)
  startedAt         DateTime @default(now())
  expiresAt         DateTime
  completedAt       DateTime?
  usedAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([email, startedAt])
  @@index([phone, startedAt])
  @@index([tokenHash])
  @@index([expiresAt])
}

model ListenerScreeningAttempt {
  id                      String                      @id @default(cuid())
  applicationId           String?
  application             CounsellorApplication?      @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  questionSetId           String?
  questionSet             ListenerScreeningQuestionSet? @relation(fields: [questionSetId], references: [id], onDelete: SetNull)
  questionSetVersion      String?
  applicationTrack        CounsellorApplicationTrack
  email                   String
  phone                   String
  score                   Int
  maxScore                Int
  passed                  Boolean                     @default(false)
  guidelinesAccepted      Boolean                     @default(false)
  guidelinesVersion       String?
  guidelinesReadSessionId String?
  guidelinesReadSeconds   Int?
  trainingCompleted       Boolean                     @default(false)
  trainingVersion         String?
  cooldownExpiresAt       DateTime?
  source                  String                      @default("healing-web")
  ipAddress               String?
  userAgent               String?
  createdAt               DateTime                    @default(now())

  @@index([email, createdAt])
  @@index([phone, createdAt])
  @@index([passed, createdAt])
  @@index([cooldownExpiresAt])
  @@index([applicationId])
  @@index([questionSetId])
}

model CareContributor {
  id                           String                         @id @default(cuid())
  applicationId                String                         @unique
  application                  CounsellorApplication          @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  applicationTrack             CounsellorApplicationTrack
  careTeamType                 CareTeamMemberType          @default(MENTAL_WELLNESS_PROFESSIONAL)
  serviceScope                 CareContributorServiceScope
  status                       CareContributorStatus          @default(PENDING_ORIENTATION)
  credentialVerificationStatus CredentialVerificationStatus   @default(PENDING)
  fullName                     String
  email                        String
  phone                        String
  gender                       PatientGender?
  city                         String
  qualification                String?
  qualifiedFrom                String?
  specialization               String?
  registrationDetails          String?
  languages                    String
  availability                 String
  supervisionDetails           String?                        @db.Text
  nonClinicalAgreementAccepted Boolean                        @default(false)
  credentialVerifiedAt         DateTime?
  supervisionVerifiedAt        DateTime?
  orientationCompletedAt       DateTime?
  activatedAt                  DateTime?
  onboardingNote               String?                        @db.Text
  // No account is created by this model. It exists to make the later account
  // and assignment step explicit and reviewable.
  platformAccountLinkedAt      DateTime?
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt

  @@index([status])
  @@index([applicationTrack])
  @@index([serviceScope])
  @@index([email])
}
