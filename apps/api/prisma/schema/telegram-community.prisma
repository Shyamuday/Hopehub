model TelegramCommunityState {
  id        String   @id @default(cuid())
  bot       String
  chatId    String
  state     String
  payload   Json?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bot, chatId])
  @@index([expiresAt])
}

model TelegramCommunitySubmission {
  id             String   @id @default(cuid())
  serial         BigInt   @unique @default(autoincrement())
  reference      String   @unique
  bot            String
  userChatId     String
  firstName      String?
  username       String?
  category       String?
  text           String
  status         String
  groupChatId    String?
  groupMessageId Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([bot, userChatId, createdAt])
  @@index([bot, groupChatId, groupMessageId])
  @@index([bot, status, createdAt])
}

model TelegramWebhookReceipt {
  id            String    @id @default(cuid())
  bot           String
  updateId      BigInt
  status        String
  error         String?
  payload       Json?
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([bot, updateId])
  @@index([status, updatedAt])
  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

model TelegramGroupHelpCommandAudit {
  id           String   @id @default(cuid())
  sourceChatId String
  targetChatId String?
  actorUserId  String?
  actorUsername String?
  actorName     String?
  sourceMessageId Int?
  command      String
  status       String
  detail       String?
  createdAt    DateTime @default(now())

  @@index([status, createdAt])
  @@index([sourceChatId, createdAt])
  @@index([actorUserId, createdAt])
}

model TelegramCampaign {
  id               String                     @id @default(cuid())
  name             String
  source           String                     @default("ADMIN")
  templateVersion  Int                        @default(0)
  bot              String                     @default("rules")
  chatId           String
  timezone         String                     @default("Asia/Kolkata")
  intervalMinutes  Int
  repeat           Boolean                    @default(true)
  isActive         Boolean                    @default(false)
  currentItemIndex Int                        @default(0)
  nextRunAt        DateTime?
  lastRunAt        DateTime?
  createdById      String?
  items            TelegramCampaignItem[]
  deliveries       TelegramCampaignDelivery[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([isActive, nextRunAt])
  @@index([chatId])
}

model TelegramCampaignItem {
  id                String                     @id @default(cuid())
  campaignId        String
  campaign          TelegramCampaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sortOrder         Int
  kind              String
  text              String?                    @db.Text
  imageUrl          String?
  buttons           Json?
  pollQuestion      String?
  pollOptions       Json?
  pollAnonymous     Boolean                    @default(true)
  pollMultiple      Boolean                    @default(false)
  pollQuiz          Boolean                    @default(false)
  correctOptionIds  Json?
  pollExplanation   String?                    @db.Text
  closeAfterMinutes Int?
  messageThreadId   Int?
  followUpOptionIds Json?
  followUpMessage   String?                    @db.Text
  deliveries        TelegramCampaignDelivery[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([campaignId, sortOrder])
  @@index([campaignId])
}

model TelegramCampaignDelivery {
  id                String                @id @default(cuid())
  campaignId        String
  campaign          TelegramCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  itemId            String?
  item              TelegramCampaignItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  telegramMessageId Int?
  telegramPollId    String?               @unique
  status            String
  error             String?
  attempts          Int                   @default(0)
  nextRetryAt       DateTime?
  pollSnapshot      Json?
  totalVoterCount   Int                   @default(0)
  closesAt          DateTime?
  sentAt            DateTime?
  votes             TelegramPollVote[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([campaignId, createdAt])
  @@index([status, closesAt])
  @@index([status, nextRetryAt])
}

model TelegramPollVote {
  id             String                   @id @default(cuid())
  deliveryId     String
  delivery       TelegramCampaignDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  telegramUserId String
  username       String?
  firstName      String?
  lastName       String?
  optionIds      Json
  followUpSentAt DateTime?
  followUpError  String?
  votedAt        DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([deliveryId, telegramUserId])
  @@index([deliveryId])
}

model TelegramCommunityEvent {
  id                String                       @id @default(cuid())
  title             String
  description       String?                      @db.Text
  chatId            String
  joinUrl           String
  startsAt          DateTime
  reminderMinutes   Int                          @default(30)
  status            String                       @default("SCHEDULED")
  telegramMessageId Int?
  announcedAt       DateTime?
  announcementDueAt DateTime?
  reminderSentAt    DateTime?
  createdById       String?
  rsvps             TelegramCommunityEventRsvp[]
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@index([status, startsAt])
  @@index([status, announcementDueAt])
  @@index([chatId])
}

model TelegramCommunityEventRsvp {
  id             String                 @id @default(cuid())
  eventId        String
  event          TelegramCommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  telegramUserId String
  username       String?
  firstName      String?
  lastName       String?
  status         String                 @default("GOING")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([eventId, telegramUserId])
  @@index([eventId, status])
}

model TelegramCommunityReaction {
  id             String   @id @default(cuid())
  chatId         String
  messageId      Int
  telegramUserId String
  username       String?
  reactions      Json
  reactedAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([chatId, messageId, telegramUserId])
  @@index([chatId, reactedAt])
  @@index([messageId])
}

model TelegramCommunityMember {
  id             String    @id @default(cuid())
  chatId         String
  telegramUserId String
  username       String?
  firstName      String?
  lastName       String?
  joinedAt       DateTime  @default(now())
  welcomeSentAt  DateTime?
  leftAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([chatId, telegramUserId])
  @@index([chatId, joinedAt])
}

model TelegramCommunityMessageCleanup {
  id          String   @id @default(cuid())
  bot         String
  chatId      String
  messageId   Int
  kind        String
  deleteAfter DateTime
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([bot, chatId, messageId])
  @@index([deleteAfter])
}

model TelegramCommunityGroupPolicy {
  id             String    @id @default(cuid())
  chatId         String    @unique
  settings       Json
  lockdownUntil  DateTime?
  lockdownReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([lockdownUntil])
}

model TelegramCommunityModerationCase {
  id                String    @id @default(cuid())
  chatId            String
  sourceMessageId   Int?
  reportedMessageId Int?
  reporterUserId    String?
  targetUserId      String?
  reason            String
  evidence          String?   @db.Text
  status            String    @default("OPEN")
  action            String?
  resolvedByUserId  String?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([chatId, status, createdAt])
  @@index([targetUserId, createdAt])
}

model TelegramCommunityRoleAssignment {
  id             String                       @id @default(cuid())
  chatId         String
  telegramUserId String
  role           String
  customRoleId   String?
  customRole     TelegramCommunityCustomRole? @relation(fields: [customRoleId], references: [id], onDelete: Cascade)
  assignedById   String
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  @@unique([chatId, telegramUserId, role])
  @@index([chatId, telegramUserId])
  @@index([customRoleId])
}

model TelegramCommunityCustomRole {
  id          String                            @id @default(cuid())
  chatId      String
  name        String
  permissions Json
  createdById String
  assignments TelegramCommunityRoleAssignment[]
  createdAt   DateTime                          @default(now())
  updatedAt   DateTime                          @updatedAt

  @@unique([chatId, name])
  @@index([chatId])
}
