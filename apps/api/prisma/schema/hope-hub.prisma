model HopeHubOffering {
  id                        String                    @id @default(cuid())
  code                      String                    @unique
  slug                      String                    @unique
  title                     String
  subtitle                  String?
  description               String                    @db.Text
  type                      HopeHubOfferingType
  priceInPaise              Int?
  compareAtPriceInPaise     Int?
  currency                  String                    @default("INR")
  discountEnabled           Boolean                   @default(false)
  discountType              HopeHubDiscountType       @default(NONE)
  discountLabel             String?
  discountCode              String?
  discountPercent           Int?
  discountFlatInPaise       Int?
  discountMaxInPaise        Int?
  discountStartsAt          DateTime?
  discountEndsAt            DateTime?
  partialPaymentEnabled     Boolean                   @default(false)
  partialPaymentType        HopeHubPartialPaymentType @default(NONE)
  partialPaymentLabel       String?
  partialPaymentPercent     Int?
  partialPaymentFlatInPaise Int?
  validityDays              Int?
  sessionCount              Int?
  sessionDurationMinutes    Int?
  deliveryMode              HopeHubDeliveryMode       @default(ONLINE_AUDIO)
  eventStartsAt             DateTime?
  eventEndsAt               DateTime?
  seatLimit                 Int?
  venue                     String?
  imageUrl                  String?
  ctaLabel                  String                    @default("Book now")
  routePath                 String?
  benefits                  String[]                  @default([])
  audience                  String[]                  @default([])
  metadata                  Json?
  isActive                  Boolean                   @default(true)
  isFeatured                Boolean                   @default(false)
  requiresLeadForm          Boolean                   @default(false)
  sortOrder                 Int                       @default(0)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @default(now()) @updatedAt

  banners           HopeHubBanner[]
  organizationLeads HopeHubOrganizationLead[]

  @@index([type, isActive])
  @@index([isFeatured, sortOrder])
  @@index([eventStartsAt])
}

model HopeHubBanner {
  id              String           @id @default(cuid())
  title           String
  subtitle        String?
  eyebrow         String?
  imageUrl        String?
  ctaLabel        String           @default("Explore")
  routePath       String
  offeringId      String?
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  backgroundColor String?
  textColor       String?
  metadata        Json?
  offering        HopeHubOffering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt

  @@index([isActive, sortOrder])
  @@index([offeringId])
}

model HopeHubOrganizationLead {
  id               String                        @id @default(cuid())
  organizationName String
  organizationType String
  contactName      String
  contactEmail     String?
  contactPhone     String?
  city             String?
  audienceSize     Int?
  needType         String?
  preferredDate    String?
  notes            String?                       @db.Text
  offeringId       String?
  status           HopeHubOrganizationLeadStatus @default(NEW)
  entryPage        String?
  followUpNotes    String?                       @db.Text
  offering         HopeHubOffering?              @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([organizationType])
  @@index([offeringId])
}

model ConsultationFollowUpEntitlement {
  id              String                    @id @default(cuid())
  consultationId  String                    @unique
  patientId       String
  durationMinutes Int                       @default(15)
  status          FollowUpEntitlementStatus @default(AVAILABLE)
  source          String                    @default("single_session_offer")
  availableAfter  DateTime?
  expiresAt       DateTime?
  requestedAt     DateTime?
  scheduledAt     DateTime?
  usedAt          DateTime?
  notes           String?                   @db.Text
  metadata        Json?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  patient      User         @relation("UserFollowUpEntitlements", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, status])
  @@index([expiresAt])
}

model Practice {
  id                String             @id @default(cuid())
  slug              String             @unique
  title             String
  shortDescription  String
  description       String             @db.Text
  type              PracticeType
  difficulty        PracticeDifficulty @default(BEGINNER)
  durationMinutes   Int?
  durationLabel     String?
  concernSlugs      String[]           @default([])
  categories        String[]           @default([])
  benefits          String[]           @default([])
  steps             Json
  tips              String[]           @default([])
  whenToUse         String[]           @default([])
  contraindications String[]           @default([])
  avoidIf           String[]           @default([])
  tags              String[]           @default([])
  mediaUrl          String?
  audioUrl          String?
  videoUrl          String?
  youtubeUrl        String?
  telegramUrl       String?
  thumbnailUrl      String?
  language          String             @default("en")
  sourceSystem      String?
  expertReviewed    Boolean            @default(false)
  expertReviewedBy  String?
  expertReviewedAt  DateTime?
  safetyLevel       String             @default("LOW")
  status            PracticeStatus     @default(DRAFT)
  sortOrder         Int                @default(0)
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  recommendationRules PracticeRecommendationRule[]
  sessions            UserPracticeSession[]

  @@index([status, sortOrder])
  @@index([type, status])
}

model PracticeRecommendationRule {
  id             String   @id @default(cuid())
  practiceId     String
  assessmentType String?
  concernSlug    String?
  minScore       Int?
  maxScore       Int?
  level          String?
  priority       Int      @default(3)
  routineSlot    String?
  isActive       Boolean  @default(true)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@index([assessmentType, minScore, maxScore])
  @@index([concernSlug, priority])
  @@index([practiceId])
}

model UserPracticeSession {
  id              String   @id @default(cuid())
  userId          String
  practiceId      String
  completedAt     DateTime @default(now())
  durationMinutes Int?
  helpfulRating   Int?
  moodBefore      String?
  moodAfter       String?
  notes           String?  @db.Text
  source          String?
  metadata        Json?
  createdAt       DateTime @default(now())

  user     User     @relation("UserPracticeSessions", fields: [userId], references: [id], onDelete: Cascade)
  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@index([practiceId, completedAt])
}

model LifestyleTip {
  id                String                 @id @default(cuid())
  slug              String                 @unique
  title             String
  shortDescription  String
  description       String                 @db.Text
  type              LifestyleTipType
  difficulty        LifestyleTipDifficulty @default(EASY)
  timeToImplement   String
  concernSlugs      String[]               @default([])
  categories        String[]               @default([])
  benefits          String[]               @default([])
  steps             Json
  tips              String[]               @default([])
  scientificBasis   String?                @db.Text
  commonMistakes    String[]               @default([])
  progressTracking  String[]               @default([])
  relatedTipSlugs   String[]               @default([])
  contraindications String[]               @default([])
  avoidIf           String[]               @default([])
  tags              String[]               @default([])
  mediaUrl          String?
  audioUrl          String?
  videoUrl          String?
  youtubeUrl        String?
  telegramUrl       String?
  thumbnailUrl      String?
  language          String                 @default("en")
  expertReviewed    Boolean                @default(false)
  expertReviewedBy  String?
  expertReviewedAt  DateTime?
  safetyLevel       String                 @default("LOW")
  status            LifestyleTipStatus     @default(DRAFT)
  sortOrder         Int                    @default(0)
  metadata          Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  recommendationRules LifestyleTipRecommendationRule[]
  sessions            UserLifestyleTipSession[]

  @@index([status, sortOrder])
  @@index([type, status])
}

model LifestyleTipRecommendationRule {
  id             String   @id @default(cuid())
  lifestyleTipId String
  assessmentType String?
  concernSlug    String?
  minScore       Int?
  maxScore       Int?
  level          String?
  priority       Int      @default(3)
  routineSlot    String?
  isActive       Boolean  @default(true)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lifestyleTip LifestyleTip @relation(fields: [lifestyleTipId], references: [id], onDelete: Cascade)

  @@index([assessmentType, minScore, maxScore], map: "LifestyleTipRecommendationRule_assessmentType_minScore_maxScore")
  @@index([concernSlug, priority])
  @@index([lifestyleTipId])
}

model UserLifestyleTipSession {
  id             String   @id @default(cuid())
  userId         String
  lifestyleTipId String
  completedAt    DateTime @default(now())
  helpfulRating  Int?
  notes          String?  @db.Text
  source         String?
  metadata       Json?
  createdAt      DateTime @default(now())

  user         User         @relation("UserLifestyleTipSessions", fields: [userId], references: [id], onDelete: Cascade)
  lifestyleTip LifestyleTip @relation(fields: [lifestyleTipId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@index([lifestyleTipId, completedAt])
}
