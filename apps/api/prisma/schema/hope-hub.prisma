model HopeHubAssessmentAttempt {
  id             String   @id @default(cuid())
  userId         String
  assessmentId   String
  assessmentType String
  category       String?
  title          String
  version        String   @default("v1")
  answers        Json
  totalScore     Int
  maxScore       Int
  level          String
  color          String?
  description    String?  @db.Text
  suggestions    Json?
  safetyFlag     Boolean  @default(false)
  retakeNumber   Int      @default(1)
  previousId     String?
  source         String?
  entryPage      String?
  completedAt    DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation("UserHopeHubAssessmentAttempts", fields: [userId], references: [id], onDelete: Cascade)
  previous       HopeHubAssessmentAttempt? @relation("HopeHubAssessmentRetakes", fields: [previousId], references: [id], onDelete: SetNull)
  retakes        HopeHubAssessmentAttempt[] @relation("HopeHubAssessmentRetakes")

  @@index([userId, assessmentId, completedAt])
  @@index([userId, completedAt])
  @@index([assessmentId])
  @@index([safetyFlag])
}

model MentalHealthProviderProfile {
  id                    String   @id @default(cuid())
  doctorId              String   @unique
  qualifications         String[] @default([])
  licenseNumber          String?
  licenseCouncil         String?
  languages              String[] @default([])
  modalities             String[] @default([])
  sessionTypes           String[] @default([])
  ageGroups              String[] @default([])
  concernsHandled        String[] @default([])
  introSessionTitle      String?
  counsellingApproach    String?  @db.Text
  safetyEscalationNote   String?  @db.Text
  acceptsHighRiskCases   Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  doctor                Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}

enum HopeHubOfferingType {
  INDIVIDUAL_SESSION
  CARE_PACKAGE
  WORKSHOP
  MEETUP
  WEBINAR
  GROUP_SESSION
  RECORDED_SESSION
  ORGANISATION_PROGRAM
  CUSTOM
}

enum HopeHubDeliveryMode {
  ONLINE_AUDIO
  ONLINE_VIDEO
  RECORDED
  CHAT
  GROUP_ONLINE
  OFFLINE
  HYBRID
  CUSTOM
}

enum HopeHubOrganizationLeadStatus {
  NEW
  CONTACTED
  PROPOSAL_SENT
  WON
  LOST
}

enum HopeHubDiscountType {
  NONE
  PERCENT
  FLAT
  REFERRAL
  CUSTOM
}

enum HopeHubPartialPaymentType {
  NONE
  PERCENT
  FLAT
}

enum FollowUpEntitlementStatus {
  AVAILABLE
  REQUESTED
  SCHEDULED
  USED
  EXPIRED
  CANCELLED
}

model HopeHubOffering {
  id                     String              @id @default(cuid())
  code                   String              @unique
  slug                   String              @unique
  title                  String
  subtitle               String?
  description            String              @db.Text
  type                   HopeHubOfferingType
  priceInPaise           Int?
  compareAtPriceInPaise  Int?
  currency               String              @default("INR")
  discountEnabled        Boolean             @default(false)
  discountType           HopeHubDiscountType  @default(NONE)
  discountLabel          String?
  discountCode           String?
  discountPercent        Int?
  discountFlatInPaise    Int?
  discountMaxInPaise     Int?
  discountStartsAt       DateTime?
  discountEndsAt         DateTime?
  partialPaymentEnabled  Boolean             @default(false)
  partialPaymentType     HopeHubPartialPaymentType @default(NONE)
  partialPaymentLabel    String?
  partialPaymentPercent  Int?
  partialPaymentFlatInPaise Int?
  validityDays           Int?
  sessionCount           Int?
  sessionDurationMinutes Int?
  deliveryMode           HopeHubDeliveryMode @default(ONLINE_AUDIO)
  eventStartsAt          DateTime?
  eventEndsAt            DateTime?
  seatLimit              Int?
  venue                  String?
  imageUrl               String?
  ctaLabel               String              @default("Book now")
  routePath              String?
  benefits               String[]            @default([])
  audience               String[]            @default([])
  metadata               Json?
  isActive               Boolean             @default(true)
  isFeatured             Boolean             @default(false)
  requiresLeadForm       Boolean             @default(false)
  sortOrder              Int                 @default(0)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  banners                HopeHubBanner[]
  organizationLeads      HopeHubOrganizationLead[]

  @@index([type, isActive])
  @@index([isFeatured, sortOrder])
  @@index([eventStartsAt])
}

model HopeHubBanner {
  id              String           @id @default(cuid())
  title           String
  subtitle        String?
  eyebrow         String?
  imageUrl        String?
  ctaLabel        String           @default("Explore")
  routePath       String
  offeringId      String?
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  backgroundColor String?
  textColor       String?
  metadata        Json?
  offering        HopeHubOffering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([isActive, sortOrder])
  @@index([offeringId])
}

model HopeHubOrganizationLead {
  id               String                        @id @default(cuid())
  organizationName String
  organizationType String
  contactName      String
  contactEmail     String?
  contactPhone     String?
  city             String?
  audienceSize     Int?
  needType         String?
  preferredDate    String?
  notes            String?                       @db.Text
  offeringId       String?
  status           HopeHubOrganizationLeadStatus @default(NEW)
  entryPage        String?
  followUpNotes    String?                       @db.Text
  offering         HopeHubOffering?              @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  @@index([status, createdAt])
  @@index([organizationType])
  @@index([offeringId])
}

model ConsultationFollowUpEntitlement {
  id              String                    @id @default(cuid())
  consultationId  String                    @unique
  patientId       String
  durationMinutes Int                       @default(15)
  status          FollowUpEntitlementStatus @default(AVAILABLE)
  source          String                    @default("single_session_offer")
  availableAfter  DateTime?
  expiresAt       DateTime?
  requestedAt     DateTime?
  scheduledAt     DateTime?
  usedAt          DateTime?
  notes           String?                   @db.Text
  metadata        Json?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  consultation    Consultation              @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  patient         User                      @relation("UserFollowUpEntitlements", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, status])
  @@index([expiresAt])
}
