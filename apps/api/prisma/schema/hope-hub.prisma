model HopeHubAssessmentAttempt {
  id                 String    @id @default(cuid())
  userId             String
  assessmentId       String
  assessmentType     String
  category           String?
  title              String
  version            String    @default("v1")
  answers            Json
  totalScore         Int
  maxScore           Int
  level              String
  color              String?
  description        String?   @db.Text
  suggestions        Json?
  safetyFlag         Boolean   @default(false)
  retakeNumber       Int       @default(1)
  previousId         String?
  source             String?
  entryPage          String?
  safetyReviewedAt   DateTime?
  safetyReviewedById String?
  safetyReviewNote   String?   @db.Text
  completedAt        DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user             User                       @relation("UserHopeHubAssessmentAttempts", fields: [userId], references: [id], onDelete: Cascade)
  safetyReviewedBy User?                      @relation("HopeHubAssessmentSafetyReviews", fields: [safetyReviewedById], references: [id], onDelete: SetNull)
  previous         HopeHubAssessmentAttempt?  @relation("HopeHubAssessmentRetakes", fields: [previousId], references: [id], onDelete: SetNull)
  retakes          HopeHubAssessmentAttempt[] @relation("HopeHubAssessmentRetakes")

  @@index([userId, assessmentId, completedAt])
  @@index([userId, completedAt])
  @@index([assessmentId])
  @@index([safetyFlag])
  @@index([safetyFlag, safetyReviewedAt])
  @@index([safetyReviewedById])
}

enum CareTeamMemberType {
  MENTAL_WELLNESS_PROFESSIONAL
  QUALIFIED_COUNSELLOR
  PSYCHOLOGY_STUDENT_VOLUNTEER
  PEER_SUPPORT_VOLUNTEER
  NLP_COACH
  LIFE_COACH
  MEDITATION_BREATHWORK_GUIDE
  CAREER_STUDY_MENTOR
}

enum ProviderDomain {
  HOMEOPATHY
  HOPE_HUB
}

enum ProviderRoleAssignmentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model ProviderRoleDefinition {
  code                      String         @id
  domain                    ProviderDomain @default(HOPE_HUB)
  label                     String
  shortLabel                String
  category                  String
  tone                      String
  description               String         @db.Text
  scope                     String         @db.Text
  bestFor                   String[]       @default([])
  notFor                    String[]       @default([])
  ctaLabel                  String
  requiresCredentials       Boolean        @default(false)
  requiresListenerScreening Boolean        @default(false)
  isClinicalCare            Boolean        @default(false)
  supportedModes            String[]       @default(["CHAT", "VOICE", "VIDEO"])
  isActive                  Boolean        @default(true)
  sortOrder                 Int            @default(0)
  version                   Int            @default(1)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @default(now()) @updatedAt

  assignments ProviderRoleAssignment[]
  services    CareTeamService[]

  @@index([domain, isActive, sortOrder])
  @@index([category, isActive])
}

model ProviderRoleAssignment {
  id               String                       @id @default(cuid())
  doctorId         String
  roleCode         String
  status           ProviderRoleAssignmentStatus @default(ACTIVE)
  isPrimary        Boolean                      @default(false)
  credentialStatus CredentialVerificationStatus @default(NOT_REQUIRED)
  verifiedAt       DateTime?
  verifiedById     String?
  assignedById     String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @default(now()) @updatedAt

  doctor Doctor                 @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  role   ProviderRoleDefinition @relation(fields: [roleCode], references: [code], onDelete: Restrict)

  @@unique([doctorId, roleCode])
  @@index([doctorId, status, isPrimary])
  @@index([roleCode, status])
}

enum CareTeamServicePricingMode {
  FIXED
  FREE_INTRO
  DISCOUNTED_FIRST
  PACKAGE
  FREE_VOLUNTEER
  PER_MINUTE
}

model MentalHealthProviderProfile {
  id                                String               @id @default(cuid())
  doctorId                          String               @unique
  careTeamType                      CareTeamMemberType   @default(MENTAL_WELLNESS_PROFESSIONAL)
  careTeamTypes                     CareTeamMemberType[] @default([])
  qualifications                    String[]             @default([])
  qualifiedFrom                     String?
  licenseNumber                     String?
  licenseCouncil                    String?
  languages                         String[]             @default([])
  modalities                        String[]             @default([])
  sessionTypes                      String[]             @default([])
  ageGroups                         String[]             @default([])
  concernsHandled                   String[]             @default([])
  introSessionTitle                 String?
  counsellingApproach               String?              @db.Text
  safetyEscalationNote              String?              @db.Text
  listenerSafetyAcknowledgedAt      DateTime?
  listenerSafetyAcknowledgedVersion String?
  onboardingPathSelectedAt          DateTime?
  acceptsHighRiskCases              Boolean              @default(false)
  autoMatchEnabled                  Boolean              @default(true)
  acceptingNewUsers                 Boolean              @default(true)
  maxSessionsPerDay                 Int?
  maxSessionsPerWeek                Int?
  createdAt                         DateTime             @default(now())
  updatedAt                         DateTime             @updatedAt

  doctor   Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  services CareTeamService[]

  @@index([doctorId])
  @@index([careTeamType])
  @@index([listenerSafetyAcknowledgedAt])
  @@index([autoMatchEnabled, acceptingNewUsers], map: "MentalHealthProviderProfile_autoMatchEnabled_acceptingNewUsers_")
}

model CareTeamService {
  id                       String                     @id @default(cuid())
  mentalHealthProfileId    String
  title                    String
  description              String?                    @db.Text
  providerRole             CareTeamMemberType?
  providerRoleCode         String
  pricingMode              CareTeamServicePricingMode @default(FIXED)
  priceInPaise             Int                        @default(0)
  firstSessionPriceInPaise Int?
  offerEndsAt              DateTime?
  offerBookingLimit        Int?
  pauseOfferWhenNoSlots    Boolean                    @default(false)
  approvalStatus           String                     @default("APPROVED")
  approvalReason           String?                    @db.Text
  approvalRequestedAt      DateTime?
  approvedAt               DateTime?
  approvedById             String?
  followUpPriceInPaise     Int?
  followUpSessionLimit     Int?
  introSessionLimit        Int                        @default(1)
  packageSessionCount      Int?
  packagePriceInPaise      Int?
  freeMinutes              Int                        @default(0)
  pricePerMinuteInPaise    Int?
  currency                 String                     @default("INR")
  durationMinutes          Int                        @default(30)
  isFree                   Boolean                    @default(false)
  isActive                 Boolean                    @default(true)
  sortOrder                Int                        @default(0)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  mentalHealthProfile MentalHealthProviderProfile @relation(fields: [mentalHealthProfileId], references: [id], onDelete: Cascade)
  roleDefinition      ProviderRoleDefinition      @relation(fields: [providerRoleCode], references: [code], onDelete: Restrict)
  availabilityRules   ProviderAvailabilityRule[]
  slots               DoctorSlot[]
  shareLinks          ProviderShareLink[]

  @@index([mentalHealthProfileId, isActive, sortOrder])
  @@index([providerRole, isActive])
  @@index([providerRoleCode, isActive])
  @@index([approvalStatus, isActive])
  @@index([offerEndsAt])
  @@index([offerBookingLimit])
}

model CareTeamPricingTemplate {
  id                       String                     @id @default(cuid())
  applicableRoleCodes      String[]                   @default([])
  title                    String
  description              String?                    @db.Text
  pricingMode              CareTeamServicePricingMode @default(FIXED)
  priceInPaise             Int                        @default(0)
  firstSessionPriceInPaise Int?
  followUpPriceInPaise     Int?
  introSessionLimit        Int                        @default(1)
  packageSessionCount      Int?
  packagePriceInPaise      Int?
  freeMinutes              Int                        @default(0)
  pricePerMinuteInPaise    Int?
  durationMinutes          Int                        @default(30)
  isFree                   Boolean                    @default(false)
  isActive                 Boolean                    @default(true)
  sortOrder                Int                        @default(0)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @default(now()) @updatedAt

  @@index([isActive, sortOrder])
}

model HopeHubLiveGroup {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  description     String?   @db.Text
  callTitle       String?
  callAgenda      String?   @db.Text
  pinnedMessage   String?   @db.Text
  roomRules       String?   @db.Text
  status          String    @default("LIVE")
  mode            String    @default("CHAT")
  slowModeSeconds Int       @default(0)
  hostUserId      String?
  createdByUserId String?
  isPublic        Boolean   @default(true)
  isActive        Boolean   @default(true)
  startsAt        DateTime?
  endedAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  messages   HopeHubLiveGroupMessage[]
  moderation HopeHubLiveGroupMemberModeration[]
  reports    HopeHubLiveGroupReport[]

  @@index([status, isActive])
  @@index([hostUserId])
  @@index([createdByUserId])
}

model HopeHubLiveGroupMessage {
  id              String    @id @default(cuid())
  groupId         String
  senderId        String
  senderName      String
  senderRole      String?
  body            String    @db.Text
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  deletedByUserId String?
  createdAt       DateTime  @default(now())

  group   HopeHubLiveGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  reports HopeHubLiveGroupReport[]

  @@index([groupId, createdAt])
  @@index([senderId, createdAt])
}

model HopeHubLiveGroupReport {
  id                String    @id @default(cuid())
  groupId           String
  messageId         String?
  reporterUserId    String
  reporterName      String?
  targetUserId      String?
  targetDisplayName String?
  reason            String
  details           String?   @db.Text
  status            String    @default("OPEN")
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  group   HopeHubLiveGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  message HopeHubLiveGroupMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([groupId, status])
  @@index([messageId])
  @@index([reporterUserId, createdAt])
  @@index([targetUserId])
}

model HopeHubLiveGroupMemberModeration {
  id                String    @id @default(cuid())
  groupId           String
  userId            String
  displayName       String?
  role              String?
  isMuted           Boolean   @default(false)
  mutedUntil        DateTime?
  isBanned          Boolean   @default(false)
  bannedAt          DateTime?
  removedAt         DateTime?
  reason            String?   @db.Text
  moderatedByUserId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  group HopeHubLiveGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId, isMuted])
  @@index([groupId, isBanned])
  @@index([userId])
}

