NODE_ENV=development

# BotFather token for the dedicated community/group bot.
TELEGRAM_COMMUNITY_BOT_TOKEN=

# polling is easiest for local/dev. Use webhook in production.
COMMUNITY_BOT_MODE=polling
PORT=3104
COMMUNITY_BOT_WEBHOOK_BASE_URL=https://api.hopehub.in
TELEGRAM_COMMUNITY_WEBHOOK_SECRET=

# Optional comma-separated Telegram numeric user IDs who can use admin commands.
# Group admins are allowed automatically inside the group.
COMMUNITY_BOT_ADMIN_USER_IDS=

# If true, non-admin links in group messages are deleted.
COMMUNITY_BOT_BLOCK_LINKS=false

# Hope Hub links shown in /links and welcome buttons.
HOPEHUB_WEBSITE_URL=https://hopehub.in
HOPEHUB_USER_BOT_URL=https://t.me/Hopehubbot
HOPEHUB_PROVIDER_BOT_URL=https://t.me/Hopehubprovidersbot
HOPEHUB_TELEGRAM_COMMUNITY_URL=https://t.me/hopehubindia
HOPEHUB_WHATSAPP_URL=
HOPEHUB_SUPPORT_EMAIL=support@hopehub.in

# Optional text overrides. Use \n for new lines.
COMMUNITY_BOT_WELCOME=Welcome to Hope Hub India 💙\nThis is a gentle community space for mental wellness, learning, and support. Please read /rules and use /links for private help.
COMMUNITY_BOT_RULES=Be kind. No shaming, judging, or personal attacks.\nDo not share private documents, medical records, payment screenshots, or someone else’s personal details.\nThis group is not an emergency service. If there is immediate danger, contact local emergency services now.\nNo spam, promotions, affiliate links, or repeated forwards.\nFor private support, use the Hope Hub Care Bot instead of posting sensitive details in group.
