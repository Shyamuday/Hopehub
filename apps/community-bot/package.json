{
  "name": "hopehub-community-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tiny Hope Hub Telegram community/group management bot.",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/hopehub/app.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1",
    "grammy": "^1.38.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
