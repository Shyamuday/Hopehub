{
  "Comment": "Route inbound hopehub.in mail to SES us-east-1 for contact@hopehub.in",
  "Changes": [
    {
      "Action": "UPSERT",
      "ResourceRecordSet": {
        "Name": "hopehub.in.",
        "Type": "MX",
        "TTL": 300,
        "ResourceRecords": [
          {
            "Value": "10 inbound-smtp.us-east-1.amazonaws.com."
          }
        ]
      }
    }
  ]
}
