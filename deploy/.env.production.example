# Copy to deploy/.env on the EC2 host. Never commit deploy/.env.

# ── API ───────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://hopehub:CHANGE_ME@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/hopehub_clinic?sslmode=require"
JWT_SECRET="generate-a-long-random-secret"
PORT=4000
NODE_ENV=production
DISABLE_DEV_DEMO=true

API_PUBLIC_URL="https://api.hopehub.in"
WEB_ORIGIN="https://hopehub.in"
CORS_ORIGINS="https://hopehub.in,https://admin.hopehub.in,https://doctor.hopehub.in,https://ops.hopehub.in"
DOCTOR_ORIGIN="https://doctor.hopehub.in"
OPERATIONS_ORIGIN="https://ops.hopehub.in"
ADMIN_ORIGIN="https://admin.hopehub.in"

# Payments
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Auth
GOOGLE_CLIENT_ID=""

# Email through AWS SES SMTP
SMTP_FROM="noreply@hopehub.in"
AWS_SES_SMTP_HOST="email-smtp.us-east-1.amazonaws.com"
AWS_SES_SMTP_PORT="587"
AWS_SES_SMTP_USERNAME=""
AWS_SES_SMTP_PASSWORD=""
CONTACT_MAIL_BUCKET="hopehub-contact-inbox"
CONTACT_MAIL_PREFIX="contact/"
CONTACT_MAIL_REGION="us-east-1"
CONTACT_REPLY_FROM="contact@hopehub.in"

# Private asset storage for profile photos and clinical uploads
ASSET_BUCKET="hopehub-assets"
ASSET_BUCKET_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Notifications
NOTIFICATION_CHANNELS="IN_APP,SMS,WHATSAPP,EMAIL"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""

# Schedulers (defaults are fine for 100–500 patients/day)
DOSE_OVERDUE_SWEEP_ENABLED=true
DOSE_OVERDUE_SWEEP_INTERVAL_MS=300000
DOSE_REMINDER_SWEEP_ENABLED=true
DOSE_REMINDER_WINDOW_MINUTES=30
