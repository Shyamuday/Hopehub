# Central production deploy constants.
# Keep this file non-secret: credentials stay in GitHub Actions secrets.

AWS_REGION=us-east-1

PATIENT_BUCKET=hopehub
ADMIN_BUCKET=hopehub-admin
DOCTOR_BUCKET=hopehub-doctors
OPERATIONS_BUCKET=hopehub-operations
HEALING_BUCKET=hopehub-healing

HOPEHUB_API_PUBLIC_URL=https://api.hopehub.in
HOPEHUB_WEB_ORIGIN=https://hopehub.in
HOPEHUB_ADMIN_ORIGIN=https://admin.hopehub.in
HOPEHUB_DOCTOR_ORIGIN=https://doctor.hopehub.in
HOPEHUB_OPERATIONS_ORIGIN=https://ops.hopehub.in
HOPEHUB_HEALING_ORIGIN=https://hopehub.in
HOPEHUB_CORS_ORIGINS=https://hopehub.in,https://admin.hopehub.in,https://doctor.hopehub.in,https://ops.hopehub.in

# Non-secret SES defaults. SMTP username/password stay on the server or in CI secrets.
HOPEHUB_SES_SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
HOPEHUB_SES_SMTP_PORT=587
HOPEHUB_EMAIL_FROM=noreply@hopehub.in
HOPEHUB_ASSET_BUCKET=hopehub-assets
HOPEHUB_ASSET_BUCKET_REGION=us-east-1
