# Central production deploy constants.
# Keep this file non-secret: credentials stay in GitHub Actions secrets.

AWS_REGION=us-east-1

# Unified frontend hosting. Each frontend is uploaded under /patient, /admin,
# /doctor, /operations, and /healing in this one bucket. CloudFront routes by
# host through deploy/cloudfront/frontend-host-router.js.
FRONTEND_BUCKET=hopehub-healing
FRONTEND_CLOUDFRONT_DISTRIBUTION_ID=E2YSXD893ZGRZ
FRONTEND_CLOUDFRONT_FUNCTION_NAME=hopehub-frontend-host-router

HOPEHUB_API_PUBLIC_URL=https://api.hopehub.in
HOPEHUB_WEB_ORIGIN=https://hopehub.in
HOPEHUB_PATIENT_ORIGIN=https://care.hopehub.in
HOPEHUB_ADMIN_ORIGIN=https://admin.hopehub.in
HOPEHUB_DOCTOR_ORIGIN=https://earn.hopehub.in
HOPEHUB_HOMEOPATHY_ORIGIN=https://doctor.hopehub.in
HOPEHUB_SUPPORT_ORIGIN=https://support.hopehub.in
HOPEHUB_OPERATIONS_ORIGIN=https://ops.hopehub.in
HOPEHUB_HEALING_ORIGIN=https://hopehub.in
HOPEHUB_CORS_ORIGINS=https://hopehub.in,https://care.hopehub.in,https://admin.hopehub.in,https://earn.hopehub.in,https://doctor.hopehub.in,https://support.hopehub.in,https://ops.hopehub.in

# Non-secret SES defaults. SMTP username/password stay on the server or in CI secrets.
HOPEHUB_SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
HOPEHUB_SES_SMTP_PORT=587
HOPEHUB_EMAIL_FROM=noreply@hopehub.in
HOPEHUB_CONTACT_MAIL_BUCKET=hopehub-contact-inbox
HOPEHUB_CONTACT_MAIL_PREFIX=contact/
HOPEHUB_CONTACT_MAIL_REGION=us-east-1
HOPEHUB_CONTACT_REPLY_FROM=contact@hopehub.in
HOPEHUB_ASSET_BUCKET=hopehub-assets
HOPEHUB_ASSET_BUCKET_REGION=us-east-1
